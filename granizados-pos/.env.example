# Postgres. En Prisma Postgres / Supabase / Neon lo copias del panel.
DATABASE_URL="postgres://usuario:clave@host:5432/postgres?sslmode=require"

# Firma de la sesión. Genera uno con: openssl rand -base64 32
SESSION_SECRET="cambia-esto-por-un-secreto-largo"

# PINs iniciales. Si no los defines, el seed usa los de desarrollo (9999/1234).
SEED_PIN_ADMIN="0000"
SEED_PIN_SARA="0000"
SEED_PIN_JUAN="0000"
